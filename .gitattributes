# Нормалізуємо перенесення рядків: у репозиторії завжди LF
* text=auto eol=lf

# Windows-скрипти залишаємо з CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Бінарні файли
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jar binary
*.keystore binary
*.jks binary
